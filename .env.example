# ==================================================
# CHARTORA.IN — ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================================

# Environment & Server Settings
APP_ENV=production
APP_URL=https://chartora.in
API_URL=https://api.chartora.in
PORT=8080
JWT_SECRET=chartora_production_jwt_secret_change_me_2026

# Database Configuration (SQLite3 for dev/testing, PostgreSQL for production)
# SQLite default: leave blank or set file path
# PostgreSQL example: postgresql://user:password@localhost:5432/chartora_db
DATABASE_URL=

# Stripe Billing Configuration (Modes: test | live | disabled)
STRIPE_MODE=disabled
STRIPE_PUBLISHABLE_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample_chartora

# Dynamic Stripe Price IDs
STRIPE_PRICE_FOREX=price_1P_forex_sample
STRIPE_PRICE_METALS=price_1P_metals_sample
STRIPE_PRICE_INDICES=price_1P_indices_sample
STRIPE_PRICE_ALLACCESS=price_1P_allaccess_sample

# Telegram Bot & Mini App Ecosystem Configuration (Modes: active | disabled)
TELEGRAM_MODE=active
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_BOT_USERNAME=ChartoraBot
TELEGRAM_WEBHOOK_SECRET=super_secret_webhook_token_chartora_2026
TELEGRAM_WEBHOOK_URL=https://api.chartora.in/api/telegram/webhook
TELEGRAM_MINI_APP_URL=https://chartora.in/public/telegram-app/index.html
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_FREE_CHANNEL_ID=-1001234567890
TELEGRAM_PREMIUM_CHANNEL_ID=-1009876543210

# Market Data & Live Feed Configuration
# DATA_MODE: 'live' (Strict production - requires MT5 or External API) | 'test' (Deterministic simulation for CI/CD)
DATA_MODE=live
LIVE_DATA_MAX_AGE_SECONDS=60

# MetaTrader 5 Cryptographic Gateway
MT5_GATEWAY_SECRET_KEY=mt5_production_hmac_secret_key_2026
MT5_HEARTBEAT_TIMEOUT_SECONDS=60
MT5_NONCE_EXPIRY_SECONDS=120

# External Market Data Fallback (Optional, e.g. TwelveData, Finnhub, Binance)
EXTERNAL_MARKET_API_KEY=

# Email Onboarding Provider
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=sample_email_api_key

